{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dev-cv.in Domain",
  "type": "object",
  "required": ["subdomain", "owner", "target"],
  "additionalProperties": false,
  "properties": {
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "owner": {
      "type": "object",
      "required": ["github"],
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["CNAME", "A", "AAAA"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
